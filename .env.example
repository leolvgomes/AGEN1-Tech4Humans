# Copie para .env (que fica fora do Git) e preencha. Nunca coloque a chave no código.

# ---- IA: qualquer API compatível com a da OpenAI ----
# OpenAI: deixe LLM_BASE_URL vazio. Gateway do evento / OpenRouter / Gemini / Ollama: informe a URL base.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Opcional: modelo diferente para o Revisor (recomendado, para não repetir o erro do Triador)
LLM_MODEL_REVISOR=
LLM_TEMPERATURA=0.1
# Desligue (0) se o gateway não aceitar response_format=json_object
LLM_JSON_MODE=1

# ---- Servidor MCP do hackathon ----
MCP_URL=http://localhost:8765/mcp
MCP_TIMEOUT_S=20
LEGADO_URL=http://localhost:8765/legado

# ---- Time ----
MAX_CASOS_PARALELOS=4
LEMBRETE_APROVACAO_S=90
# playwright (navegador real, padrão) ou http (reserva sem navegador)
OPERADOR_MODO=playwright
OPERADOR_HEADLESS=1

# ---- Canal humano ----
CANAL_HUMANO_PORT=8080
